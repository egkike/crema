---
// Login Page
---

<html lang="es" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crema Admin - Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-surface-950 text-surface-100 font-sans antialiased">
  <div id="app"></div>
  <script>
    // Simple React-like app without actual React for quick setup
    // This is a placeholder - will be replaced with actual React components
    const app = document.getElementById('app');
    app.innerHTML = `
      <div class="min-h-screen flex items-center justify-center p-4">
        <div class="w-full max-w-md">
          <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-cream-500">🍦 Crema</h1>
            <p class="text-surface-400 mt-2">Panel de Administración</p>
          </div>
          
          <div class="bg-surface-900 border border-surface-800 rounded-2xl p-8 shadow-dark">
            <form id="login-form" class="space-y-6">
              <div>
                <label class="block text-sm font-medium text-surface-300 mb-2">Usuario</label>
                <input 
                  type="text" 
                  name="username"
                  class="w-full px-4 py-3 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 placeholder-surface-500 focus:outline-none focus:border-cream-500 focus:ring-1 focus:ring-cream-500 transition-colors"
                  placeholder="admin_crema"
                  required
                >
              </div>
              
              <div>
                <label class="block text-sm font-medium text-surface-300 mb-2">Contraseña</label>
                <input 
                  type="password" 
                  name="password"
                  class="w-full px-4 py-3 bg-surface-800 border border-surface-700 rounded-xl text-surface-100 placeholder-surface-500 focus:outline-none focus:border-cream-500 focus:ring-1 focus:ring-cream-500 transition-colors"
                  placeholder="••••••••••••"
                  required
                >
              </div>
              
              <button 
                type="submit"
                class="w-full py-3 px-4 bg-cream-500 hover:bg-cream-600 text-surface-900 font-semibold rounded-xl transition-colors shadow-warm hover:shadow-warm-lg"
              >
                Iniciar Sesión
              </button>
            </form>
            
            <div id="error-message" class="mt-4 p-3 bg-red-900/30 border border-red-800 rounded-lg text-red-400 text-sm hidden"></div>
          </div>
          
          <p class="text-center text-surface-500 text-sm mt-6">
            © 2026 Crema Platform
          </p>
        </div>
      </div>
    `;
    
    // Handle form submission
    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);
      const errorDiv = document.getElementById('error-message');
      
      errorDiv.classList.add('hidden');
      
      try {
        // Use ngrok URL for production, localhost for development
        const API_BASE = window.location.hostname.includes('localhost') 
          ? 'http://localhost:3000' 
          : 'https://unforsworn-skiagraphical-claretta.ngrok-free.dev';

        const response = await fetch(`${API_BASE}/api/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            username: formData.get('username'),
            password: formData.get('password')
          }),
          credentials: 'include'
        });
        
        const data = await response.json();
        
        if (!response.ok) {
          errorDiv.textContent = data.error || 'Error de autenticación';
          errorDiv.classList.remove('hidden');
        } else if (data.requires2FA) {
          // Show 2FA input
          form.innerHTML = `
            <div class="text-center mb-6">
              <div class="text-4xl mb-2">🔐</div>
              <h2 class="text-xl font-semibold">Verificación de Dos Factores</h2>
              <p class="text-surface-400 text-sm">Ingresa el código de tu aplicación autenticadora</p>
            </div>
            <div class="mb-6">
              <input 
                type="text" 
                name="code"
                class="w-full px-4 py-3 text-center text-2xl tracking-widest bg-surface-800 border border-surface-700 rounded-xl text-surface-100 placeholder-surface-500 focus:outline-none focus:border-cream-500 focus:ring-1 focus:ring-cream-500"
                placeholder="000000"
                maxlength="6"
                required
              >
            </div>
            <button 
              type="submit"
              class="w-full py-3 px-4 bg-cream-500 hover:bg-cream-600 text-surface-900 font-semibold rounded-xl transition-colors"
            >
              Verificar
            </button>
            <button type="button" id="back-btn" class="w-full mt-3 py-2 text-surface-400 hover:text-surface-300 text-sm">
              ← Volver
            </button>
          `;
        } else if (data.success) {
          window.location.href = '/';
        }
      } catch (err) {
        errorDiv.textContent = 'Error de conexión';
        errorDiv.classList.remove('hidden');
      }
    });
  </script>
</body>
</html>