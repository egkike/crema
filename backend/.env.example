# --- ENTORNO ---
NODE_ENV=development # development | production | test
PORT=3000
API_BASE_URL=http://localhost:3000
APP_URL=http://localhost:5173

# --- BASE DE DATOS POSTGRES ---
POSTGRES_USER=app_user
POSTGRES_PASSWORD=TuPassword
POSTGRES_DB=app_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=your_secure_password
DB_NAME=crema_db
DB_SCHEMA=public

# --- REDIS (Motor para BullMQ y Cache) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD= # Dejar vacío si no tiene password en local
REDIS_DB=0

# --- SEGURIDAD Y JWT ---
# Generar con: openssl rand -base64 64
SECRET_JWT_KEY=your_access_token_secret_min_64_chars
SECRET_REFRESH_JWT_KEY=your_refresh_token_secret_min_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PASSWORD_PEPPER=your_complex_pepper_string_32_chars

# --- CORS ---
# Dominios permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PAGOS: MERCADO PAGO ---
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxx-xxxx
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxx-xxxx
MERCADO_PAGO_WEBHOOK_SECRET=your_mp_webhook_secret

# --- EMAIL (Nodemailer / Mailtrap) ---
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_user
SMTP_PASS=your_password
EMAIL_FROM="Crema Support <noreply@crema.com>"

# --- INFRAESTRUCTURA Y SERVICIOS ---
RECAPTCHA_SECRET_KEY=your_google_recaptcha_secret
MAX_GLOBAL_UPLOAD_SIZE_MB=300

# --- STREAMING (Cloudflare / Mux) ---
CLOUDFLARE_ACCOUNT_ID=your_id
CLOUDFLARE_STREAM_KEY_ID=your_key_id
CLOUDFLARE_STREAM_KEY_SECRET=your_secret

MUX_TOKEN_ID=your_id
MUX_TOKEN_SECRET=your_secret
MUX_SIGNING_KEY=your_key
MUX_SIGNING_KEY_ID=your_id

# --- TÚNEL: NGROK (Solo para Webhooks en Local) ---
NGROK_AUTHTOKEN=your_token
NGROK_DOMAIN=your_custom_domain.ngrok-free.dev
