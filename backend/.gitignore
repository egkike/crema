# Dependencias
node_modules/
.pnpm-store/
.pnpm-debug.log

# Datos de PostgreSQL (no subir)
postgres-data/
postgres-data*  # cubre postgres-data-clean, etc.

# Archivos de compilación y salida
dist/
build/
out/

# Logs
logs/*
!logs/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Entorno y secretos
.env
.env.*
!.env.example       # Permitimos el ejemplo para que otros sepan qué variables usar

# Editor y sistema operativo
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Tests y cobertura
coverage/
.nyc_output/
test-results/
vitest-report/
utils/dev/

# Archivos temporales y caché
*.swp
*.swo
*.tmp
*.bak
*.txt
*.http
*.cache
.eslintcache
.prettierrc.cache
uploads/* # Si guardas archivos localmente
!uploads/.gitkeep   # Permite que la carpeta exista pero vacía
*.tmp
*.bak
DOCUMENTACION.md

# PostgreSQL / bases de datos locales (por si exportas dumps)
*.sql.dump
*.dump
pgdata/

# Docker
docker-compose.override.yml

# Archivos generados por herramientas
tsconfig.tsbuildinfo
.eslintrc.js.cache
.pi-lens/