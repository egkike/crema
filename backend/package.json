{
  "name": "crema-backend",
  "version": "1.0.0",
  "description": "Backend de Crema - Plataforma all-in-one para creadores y afiliados",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "rm -rf dist",
    "build": "esbuild src/index.ts --bundle --platform=node --target=es2020 --outfile=dist/index.js --format=cjs --packages=external",
    "prestart:prod": "mkdir -p logs",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_NO_WARNINGS=1 vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ci": "docker-compose -f docker-compose.test.yml up -d db-test && pnpm test && docker-compose -f docker-compose.test.yml down"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "api-rest",
    "postgresql"
  ],
  "author": "Kike Garcia",
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@types/sanitize-html": "^2.16.1",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.74.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "^2.12.0",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.0",
    "otplib": "^13.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "qrcode": "^1.5.4",
    "qs": "^6.15.0",
    "sanitize-html": "^2.17.4",
    "slugify": "^1.6.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.9",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.3.5",
    "@eslint/js": "^9.39.2",
    "@types/axios": "^0.14.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mercadopago": "^1.5.11",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.6",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/ua-parser-js": "^0.7.39",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.1.4"
  }
}
